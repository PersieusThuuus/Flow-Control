# =============================================================================
# FlowControl — environment configuration
# Copy this file to `.env` and adjust the values. NEVER commit a real .env.
# =============================================================================

# --- Database ---------------------------------------------------------------
# SQLite database file used by Prisma.
# Local development example (absolute path):
#   DATABASE_URL=file:/home/z/my-project/db/custom.db
# Docker example (path inside the container, backed by a volume):
#   DATABASE_URL=file:/app/db/custom.db
DATABASE_URL=file:/home/z/my-project/db/custom.db

# --- Sessions ---------------------------------------------------------------
# HMAC-SHA256 key used to derive the digests of session tokens that are stored
# in the database (raw tokens are never stored).
# REQUIRED in production: the application refuses to start login flows without
# a secret of at least 16 characters (see src/server/auth.ts). Generate one
# with, for example:  openssl rand -hex 32
SESSION_SECRET=

# --- Document vault ---------------------------------------------------------
# Directory where uploaded document files are stored. This directory MUST stay
# OUTSIDE of /public — files are served only through the authorized download
# endpoint. Defaults to ./storage/documents when unset.
STORAGE_DIR=./storage/documents

# Maximum accepted upload size in megabytes (default 10).
MAX_UPLOAD_MB=10

# --- Email (optional) -------------------------------------------------------
# SMTP relay for email notifications. In this delivery no SMTP relay is
# available: when these variables are unset, every email attempt is recorded
# honestly in the EmailLog table with status SKIPPED_NO_SMTP — the system
# never claims an email was sent when it was not.
# NOTE: these are placeholders for the transport integration seam documented
# in docs/LIMITATIONS.md; setting them requires wiring a real transport
# (e.g. nodemailer) in src/server/notify.ts before delivery is attempted.
SMTP_HOST=
SMTP_PORT=
